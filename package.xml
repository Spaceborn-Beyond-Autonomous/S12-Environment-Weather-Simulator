<?xml version="1.0"?>
<package format="3">

  <name>environment_weather_simulator</name>
  <version>1.0.0</version>

  <description>
    Environment and Weather Simulator for autonomous systems.
    Supports configurable weather effects, environmental modeling,
    Gazebo world generation, and sensor noise simulation.
  </description>

  <maintainer email="YOUR_EMAIL_HERE">Chetanya Barodiya</maintainer>

  <license>Apache-2.0</license>

  <!-- Build Tool -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime -->
  <exec_depend>python3</exec_depend>

  <!-- ROS2 -->
  <exec_depend>rclpy</exec_depend>

  <!-- Launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Gazebo -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- Messages -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <!-- TF -->
  <exec_depend>tf2_ros</exec_depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>