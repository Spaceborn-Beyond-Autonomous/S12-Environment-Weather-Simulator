<?xml version="1.0"?>
<sdf version="1.6">
  <model name="tunnel">
    <static>true</static>

    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://tunnel/meshes/tunnel.stl</uri>
            <scale>5 30 30</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://tunnel/meshes/tunnel.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
