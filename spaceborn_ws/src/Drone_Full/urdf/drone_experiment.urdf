		<child link="barometer_link"/>

		<origin xyz="0 -0.04 0.04" rpy="0 0 0"/>

	</joint>

	<gazebo reference="barometer_link">

		<material>Gazebo/Blue</material>

		<plugin
				name="barometer_plugin"
				filename="libgazebo_barometer_plugin.so">

			<robotNamespace>/drone</robotNamespace>

			<pubRate>50</pubRate>

			<baroTopic>/baro</baroTopic>

			<baroDriftPaPerSec>0</baroDriftPaPerSec>

		</plugin>

	</gazebo>

<!-- ====================== GROUND TRUTH ====================== -->

	<gazebo>

		<plugin
				name="groundtruth_plugin"
				filename="libgazebo_groundtruth_plugin.so">

			<robotNamespace>/drone</robotNamespace>

		</plugin>

	</gazebo>
  

<!-- ====================== ODOMETRY ====================== -->

	<gazebo>

		<plugin
				name="odometry_plugin"
				filename="libgazebo_ros_p3d.so">

			<ros>
				<namespace>/drone</namespace>
			</ros>

			<body_name>Drone_link</body_name>

			<frame_name>odom</frame_name>

			<child_frame_name>Drone_link</child_frame_name>

			<publish_tf>true</publish_tf>

			<update_rate>30</update_rate>

			<gaussian_noise>0.0</gaussian_noise>

		</plugin>

	</gazebo>

<!-- ====================== MULTIROTOR BASE ====================== -->

	<gazebo>

		<plugin
				name="multirotor_base_plugin"
				filename="libgazebo_multirotor_base_plugin.so">

			<robotNamespace>/drone</robotNamespace>

			<linkName>Drone_link</linkName>

			<rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>

		</plugin>

	</gazebo>

<!-- ====================== FRONT LEFT MOTOR ====================== -->

	<gazebo>

		<plugin
				name="front_left_motor_model"
				filename="libgazebo_motor_model.so">

			<robotNamespace>/drone</robotNamespace>

			<jointName>leftfrontprop</jointName>

			<linkName>leftfront_prop</linkName>

			<turningDirection>cw</turningDirection>

			<timeConstantUp>0.0125</timeConstantUp>

			<timeConstantDown>0.025</timeConstantDown>

			<maxRotVelocity>1100</maxRotVelocity>

			<motorConstant>5.84e-06</motorConstant>

			<momentConstant>0.06</momentConstant>

			<commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>

			<motorNumber>0</motorNumber>

			<rotorDragCoefficient>0.000175</rotorDragCoefficient>

			<rollingMomentCoefficient>1e-06</rollingMomentCoefficient>

			<motorSpeedPubTopic>/motor_speed/0</motorSpeedPubTopic>

			<rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>

		</plugin>

	</gazebo>


<!-- ====================== FRONT RIGHT MOTOR ====================== -->

	<gazebo>

		<plugin
				name="front_right_motor_model"
				filename="libgazebo_motor_model.so">

			<robotNamespace>/drone</robotNamespace>

			<jointName>rightfrontprop</jointName>

			<linkName>rightfront_prop</linkName>

			<turningDirection>ccw</turningDirection>

			<timeConstantUp>0.0125</timeConstantUp>

			<timeConstantDown>0.025</timeConstantDown>

			<maxRotVelocity>1100</maxRotVelocity>

			<motorConstant>5.84e-06</motorConstant>

			<momentConstant>0.06</momentConstant>

			<commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>

			<motorNumber>1</motorNumber>

			<rotorDragCoefficient>0.000175</rotorDragCoefficient>

			<rollingMomentCoefficient>1e-06</rollingMomentCoefficient>

			<motorSpeedPubTopic>/motor_speed/1</motorSpeedPubTopic>

			<rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>

		</plugin>

	</gazebo>


<!-- ====================== BACK LEFT MOTOR ====================== -->

	<gazebo>

		<plugin
				name="back_left_motor_model"
				filename="libgazebo_motor_model.so">

			<robotNamespace>/drone</robotNamespace>

			<jointName>leftbackprop</jointName>

			<linkName>leftback_prop</linkName>

			<turningDirection>ccw</turningDirection>

			<timeConstantUp>0.0125</timeConstantUp>

			<timeConstantDown>0.025</timeConstantDown>

			<maxRotVelocity>1100</maxRotVelocity>

			<motorConstant>5.84e-06</motorConstant>

			<momentConstant>0.06</momentConstant>

			<commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>

			<motorNumber>2</motorNumber>

			<rotorDragCoefficient>0.000175</rotorDragCoefficient>

			<rollingMomentCoefficient>1e-06</rollingMomentCoefficient>

			<motorSpeedPubTopic>/motor_speed/2</motorSpeedPubTopic>

			<rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>

		</plugin>

	</gazebo>




<!-- ====================== BACK RIGHT MOTOR ====================== -->

	<gazebo>

		<plugin
				name="back_right_motor_model"
				filename="libgazebo_motor_model.so">

			<robotNamespace>/drone</robotNamespace>

			<jointName>rightbackprop</jointName>

			<linkName>rightback_prop</linkName>

			<turningDirection>cw</turningDirection>

			<timeConstantUp>0.0125</timeConstantUp>

			<timeConstantDown>0.025</timeConstantDown>

			<maxRotVelocity>1100</maxRotVelocity>

			<motorConstant>5.84e-06</motorConstant>

			<momentConstant>0.06</momentConstant>

			<commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>

			<motorNumber>3</motorNumber>

			<rotorDragCoefficient>0.000175</rotorDragCoefficient>

			<rollingMomentCoefficient>1e-06</rollingMomentCoefficient>

			<motorSpeedPubTopic>/motor_speed/3</motorSpeedPubTopic>

			<rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>

		</plugin>

	</gazebo>

<!-- ====================== MAVLINK INTERFACE ====================== -->

	<gazebo>

		<plugin
				name="mavlink_interface"
				filename="libgazebo_mavlink_interface.so">

			<robotNamespace>/drone</robotNamespace>

			<!-- IMU topic -->
			<imuSubTopic>/imu</imuSubTopic>

			<!-- MAVLink communication -->
			<mavlink_addr>INADDR_ANY</mavlink_addr>

			<mavlink_tcp_port>4560</mavlink_tcp_port>

			<mavlink_udp_port>14560</mavlink_udp_port>

			<serialEnabled>0</serialEnabled>

			<!-- QGroundControl -->
			<qgc_addr>INADDR_ANY</qgc_addr>

			<qgc_udp_port>14550</qgc_udp_port>

			<!-- MAVSDK -->
			<sdk_addr>INADDR_ANY</sdk_addr>

			<sdk_udp_port>14540</sdk_udp_port>

			<!-- Hardware-in-the-loop -->
			<hil_mode>0</hil_mode>

			<hil_state_level>0</hil_state_level>

			<!-- Odometry -->
			<send_odometry>1</send_odometry>

			<!-- Lockstep -->
			<enable_lockstep>1</enable_lockstep>

			<!-- Use TCP -->
			<use_tcp>1</use_tcp>

			<!-- Topic receiving motor commands -->
			<motorSpeedCommandPubTopic>
				/gazebo/command/motor_speed
			</motorSpeedCommandPubTopic>

			<!-- ================= CONTROL CHANNELS ================= -->

			<control_channels>

				<!-- Front Left -->
				<channel name="rotor1">

					<input_index>0</input_index>

					<input_offset>0</input_offset>

					<input_scaling>1000</input_scaling>

					<zero_position_disarmed>0</zero_position_disarmed>

					<zero_position_armed>100</zero_position_armed>

					<joint_control_type>velocity</joint_control_type>

				</channel>

				<!-- Front Right -->
				<channel name="rotor2">

					<input_index>1</input_index>

					<input_offset>0</input_offset>

					<input_scaling>1000</input_scaling>

					<zero_position_disarmed>0</zero_position_disarmed>

					<zero_position_armed>100</zero_position_armed>

					<joint_control_type>velocity</joint_control_type>

				</channel>

				<!-- Back Left -->
				<channel name="rotor3">

					<input_index>2</input_index>

					<input_offset>0</input_offset>

					<input_scaling>1000</input_scaling>

					<zero_position_disarmed>0</zero_position_disarmed>

					<zero_position_armed>100</zero_position_armed>

					<joint_control_type>velocity</joint_control_type>

				</channel>

				<!-- Back Right -->
				<channel name="rotor4">

					<input_index>3</input_index>

					<input_offset>0</input_offset>

					<input_scaling>1000</input_scaling>

					<zero_position_disarmed>0</zero_position_disarmed>

					<zero_position_armed>100</zero_position_armed>

					<joint_control_type>velocity</joint_control_type>

				</channel>

			</control_channels>

		</plugin>

	</gazebo>
   
</robot>
