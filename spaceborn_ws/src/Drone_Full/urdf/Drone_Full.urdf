  <gazebo reference="drone_lidar_link">
    <material>Gazebo/DarkGrey</material>
    <sensor name="drone_lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </ray>
      <plugin name="drone_lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/drone</namespace>
          <remapping>~/out:=lidar/points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <!-- FIX: frame_name updated to rover_lidar_link -->
        <frame_name>drone_lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>


    <!-- ================= DEPTH CAMERA ================= -->

  <link name="depth_camera_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0"
               izz="0.00001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="depth_camera_joint" type="fixed">
    <parent link="Drone_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="0.07 0 0.03" rpy="0 0 0"/>
  </joint>

  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>

      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>

      <plugin
        name="depth_camera_controller"
        filename="libgazebo_ros_camera.so">

        <frame_name>depth_camera_link</frame_name>

        <ros>
          <namespace>/depth_camera</namespace>
        </ros>

        <camera_name>depth_camera</camera_name>

      </plugin>
    </sensor>
  </gazebo>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
   </inertial>
   <visual>
     <geometry>
       <box size="0.02 0.02 0.01"/>
     </geometry>
     <material name="blue">
       <color rgba="0 0 1 1"/>
     </material>
   </visual>

   <collision>
     <geometry>
       <box size="0.02 0.02 0.01"/>
     </geometry>
   </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="Drone_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.08 0 0.01" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>true</visualize>
      <plugin name="imu_plugin"
        filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/imu</namespace>
          <remapping>~/out:=data</remapping>
       </ros>
       <frame_name>imu_link</frame_name>
     </plugin>
   </sensor>
   </gazebo>

  <!-- ================================================================ -->
  <!-- THRUST PLUGINS — added to enable flight, nothing else changed.   -->
  <!-- One force plugin per rotor using libgazebo_ros_force.so.         -->
  <!-- Each subscribes a Wrench topic; a control node will publish the  -->
  <!-- thrust value needed per motor to fly/hover/move.                 -->
  <!-- ================================================================ -->

  <gazebo>
    <plugin name="leftfront_motor_force" filename="libgazebo_ros_force.so">
      <ros>
        <namespace>/drone</namespace>
        <remapping>gazebo_ros_force:=motor1/force</remapping>
      </ros>
      <link_name>leftfront_prop</link_name>
      <force_frame>link</force_frame>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="rightfront_motor_force" filename="libgazebo_ros_force.so">
      <ros>
        <namespace>/drone</namespace>
        <remapping>gazebo_ros_force:=motor2/force</remapping>
      </ros>
      <link_name>rightfront_prop</link_name>
      <force_frame>link</force_frame>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="leftback_motor_force" filename="libgazebo_ros_force.so">
      <ros>
        <namespace>/drone</namespace>
        <remapping>gazebo_ros_force:=motor3/force</remapping>
      </ros>
      <link_name>leftback_prop</link_name>
      <force_frame>link</force_frame>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="rightback_motor_force" filename="libgazebo_ros_force.so">
      <ros>
        <namespace>/drone</namespace>
        <remapping>gazebo_ros_force:=motor4/force</remapping>
      </ros>
      <link_name>rightback_prop</link_name>
      <force_frame>link</force_frame>
    </plugin>
  </gazebo>

  <!-- ================================================================ -->
  <!-- PX4 SENSOR ADDITIONS - GPS, magnetometer, barometer only, added   -->
  <!-- to match the style/parameters of the reference Drone_Full.sdf    -->
  <!-- you provided. Nothing else in this file was touched.             -->
  <!-- Still requires the PX4 sitl_gazebo-classic plugins to be built   -->
  <!-- (libgazebo_gps_plugin.so, libgazebo_magnetometer_plugin.so,      -->
  <!-- libgazebo_barometer_plugin.so) and on GAZEBO_PLUGIN_PATH.        -->
  <!-- ================================================================ -->

  <!-- GPS -->
  <gazebo reference="Drone_link">
    <sensor name="gps" type="gps">
      <pose>0 0 0 0 0 0</pose>
      <plugin name="gps_plugin" filename="libgazebo_gps_plugin.so">
        <robotNamespace>/drone</robotNamespace>
        <gpsNoise>1</gpsNoise>
        <gpsXYRandomWalk>2.0</gpsXYRandomWalk>
        <gpsZRandomWalk>4.0</gpsZRandomWalk>
        <gpsXYNoiseDensity>0.0002</gpsXYNoiseDensity>
        <gpsZNoiseDensity>0.0004</gpsZNoiseDensity>
        <gpsVXYNoiseDensity>0.2</gpsVXYNoiseDensity>
        <gpsVZNoiseDensity>0.4</gpsVZNoiseDensity>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Magnetometer (compass) -->
  <gazebo>
    <plugin name="magnetometer_plugin" filename="libgazebo_magnetometer_plugin.so">
      <robotNamespace>/drone</robotNamespace>
      <pubRate>100</pubRate>
      <noiseDensity>0.0004</noiseDensity>
      <randomWalk>6.4e-06</randomWalk>
      <biasCorrelationTime>600</biasCorrelationTime>
      <magTopic>/mag</magTopic>
    </plugin>
  </gazebo>

  <!-- Barometer -->
  <gazebo>
    <plugin name="barometer_plugin" filename="libgazebo_barometer_plugin.so">
      <robotNamespace>/drone</robotNamespace>
      <pubRate>50</pubRate>
      <baroTopic>/baro</baroTopic>
      <baroDriftPaPerSec>0</baroDriftPaPerSec>
    </plugin>
  </gazebo>

</robot>
