      velocity="100" />
    <dynamics
      damping="0.01"
      friction="0.1" />
  </joint>

  <gazebo reference="drone_lidar_link">
    <sensor name="drone_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>lidar</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ================= DEPTH CAMERA ================= -->

  <link name="depth_camera_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0"
               izz="0.00001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="depth_camera_joint" type="fixed">
    <parent link="Drone_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="0.07 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- gz-sim native "rgbd_camera" sensor. Publishes depth + color images
       and a point cloud on gz-transport topics under /depth_camera/... -->
  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <topic>depth_camera</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
   </inertial>
   <visual>
     <geometry>
       <box size="0.02 0.02 0.01"/>
     </geometry>
     <material name="blue">
       <color rgba="0 0 1 1"/>
     </material>
   </visual>

   <collision>
     <geometry>
       <box size="0.02 0.02 0.01"/>
     </geometry>
   </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="Drone_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.08 0 0.01" rpy="0 0 0"/>
  </joint>

  <!-- gz-sim native "imu" sensor. Needs the gz-sim-imu-system plugin
       (loaded below at model level) to actually produce data. -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <topic>imu</topic>
      <update_rate>200</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- gz-sim native "navsat" (GPS) sensor -->
  <gazebo reference="Drone_link">
    <sensor name="navsat_sensor" type="navsat">
      <topic>navsat</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- gz-sim native "magnetometer" sensor -->
  <gazebo reference="Drone_link">
    <sensor name="magnetometer_sensor" type="magnetometer">
      <topic>magnetometer</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- gz-sim native "air_pressure" (barometer) sensor -->
  <gazebo reference="Drone_link">
    <sensor name="air_pressure_sensor" type="air_pressure">
      <topic>air_pressure</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <air_pressure>
        <reference_altitude>0</reference_altitude>
        <pressure>
          <noise type="gaussian">
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </pressure>
      </air_pressure>
    </sensor>
  </gazebo>


  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-multicopter-motor-model" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone</robotNamespace>
      <jointName>leftfrontprop</jointName>
      <linkName>leftfront_prop</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.06</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <priorRotorVelSlowdownSim>10</priorRotorVelSlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-multicopter-motor-model" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone</robotNamespace>
      <jointName>rightfrontprop</jointName>
      <linkName>rightfront_prop</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.06</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <priorRotorVelSlowdownSim>10</priorRotorVelSlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-multicopter-motor-model" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone</robotNamespace>
      <jointName>leftbackprop</jointName>
      <linkName>leftback_prop</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.06</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <priorRotorVelSlowdownSim>10</priorRotorVelSlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-multicopter-motor-model" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>drone</robotNamespace>
      <jointName>rightbackprop</jointName>
      <linkName>rightback_prop</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.06</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <priorRotorVelSlowdownSim>10</priorRotorVelSlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </gazebo>



</robot>
