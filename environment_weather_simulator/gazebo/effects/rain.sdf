<model name="rain_generator">
  <static>true</static>

  <pose>0 0 12 0 1.5708 0</pose>

  <link name="rain_link">

    <particle_emitter
      name="rain_emitter"
      type="box">

      <size>20 20 20</size>

      <particle_size>0.04 0.04 0.6</particle_size>

      <rate>10000</rate>

      <duration>0</duration>

      <emitting>true</emitting>

      <lifetime>0.05</lifetime>

      <min_velocity>1.0</min_velocity>

      <max_velocity>2.0</max_velocity>

      <scale_rate>0.0</scale_rate>

      <material>
        <ambient>0.5 0.7 1.0 1</ambient>
        <diffuse>0.5 0.7 1.0 1</diffuse>
      </material>

    </particle_emitter>

  </link>

</model>