<plugin
    filename="gz-sim-physics-system"
    name="gz::sim::systems::Physics"/>

<plugin
    filename="gz-sim-user-commands-system"
    name="gz::sim::systems::UserCommands"/>

<plugin
    filename="gz-sim-scene-broadcaster-system"
    name="gz::sim::systems::SceneBroadcaster"/>

<plugin
    filename="gz-sim-sensors-system"
    name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
</plugin>

<plugin
    filename="gz-sim-particle-emitter-system"
    name="gz::sim::systems::ParticleEmitter"/>

<!-- Rain Emitter Model -->
<model name="rain_generator">
    <static>true</static>
    <pose>0 0 12 0 1.570 0</pose>

    <link name="rain_link">
        <particle_emitter name="rain_emitter" type="box">
            <size>20 20 20</size>
            <particle_size>0.02 0.6 0.02</particle_size>

            <rate>10000</rate>
            <duration>0</duration>
            <emitting>true</emitting>

            <lifetime>0.3</lifetime>

            <min_velocity>8.0</min_velocity>
            <max_velocity>12.0</max_velocity>

            <scale_rate>0.0</scale_rate>

            <material>
                <ambient>1 1 1 1</ambient>
                <diffuse>1 1 1 1</diffuse>
                <specular>0.9 0.9 0.9 1</specular>
            </material>
        </particle_emitter>
    </link>
</model>