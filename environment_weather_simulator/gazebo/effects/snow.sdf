<model name="snow_generator">

  <static>true</static>

  <pose>0 0 12 0 1.5708 0</pose>

  <link name="snow_link">

    <particle_emitter
        name="snow_emitter"
        type="box">

      <size>20 20 20</size>

      <particle_size>0.1 0.1 0.1</particle_size>

      <rate>500</rate>

      <duration>0</duration>

      <emitting>true</emitting>

      <lifetime>8</lifetime>

      <min_velocity>0.8</min_velocity>

      <max_velocity>1.5</max_velocity>

      <scale_rate>0.05</scale_rate>

      <material>

        <ambient>1 1 1 1</ambient>

        <diffuse>1 1 1 1</diffuse>

      </material>

    </particle_emitter>

  </link>

</model>
