<model name="fog_generator">

  <static>true</static>

  <pose>0 0 0 -1.5708 0 0</pose>

  <link name="fog_link">

    <particle_emitter
      name="fog_emitter"
      type="box">

      <size>20 20 20</size>

      <particle_size>1.0 1.0 1.0</particle_size>

      <rate>15</rate>

      <duration>0</duration>

      <emitting>true</emitting>

      <lifetime>3</lifetime>

      <min_velocity>0.1</min_velocity>

      <max_velocity>0.5</max_velocity>

      <scale_rate>0.2</scale_rate>

      <material>
        <ambient>0.9 0.9 0.9 0.05</ambient>
        <diffuse>0.9 0.9 0.9 0.05</diffuse>
      </material>

    </particle_emitter>

  </link>

</model>